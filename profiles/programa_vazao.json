           "pulses": "Flow_Pulsos", "pulses_total": "Flow_PulsosTot", "pulse_status": "Flow_PStatus",
           "t_first": "Flow_T1_ms", "t_last": "Flow_T2_ms", "timing_res": "Flow_ScanF_ms",
           "optional": ["mode", "pulses", "pulses_total", "pulse_status", "t_first", "t_last", "timing_res"]}
